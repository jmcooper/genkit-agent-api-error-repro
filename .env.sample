# USE_REAL_MODEL:
#   false = reproduce against a fake offline model.
#   true  = reproduce against a real Gemini model. Requires GEMINI_API_KEY to be set
USE_REAL_MODEL=false

# GEMINI_API_KEY: Set to a valid API key. Only required if USE_REAL_MODEL=true
GEMINI_API_KEY=

# GEMINI_API_KEY: Set to a valid gemini model. Only used if USE_REAL_MODEL=true
GEMINI_MODEL_NAME='gemini-3.5-flash'